// prisma/schema.prisma
// Cada módulo añade sus propios modelos y su propia migración.
// tenancy-auth (#4) añade la primera migración de negocio: Organization,
// User, Invitation, LoginToken (ver specs/tenancy-auth/design.md).

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  admin
  collector
}

enum UserStatus {
  active
  inactive
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  invitations Invitation[]
  forms       Form[]
  submissions Submission[]
  storedFiles StoredFile[]

  @@map("organizations")
}

model User {
  id             String     @id @default(cuid())
  organizationId String
  email          String     @unique
  name           String
  passwordHash   String
  role           Role
  status         UserStatus @default(active)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  loginTokens  LoginToken[]

  @@index([organizationId])
  @@map("users")
}

model Invitation {
  id              String    @id @default(cuid())
  organizationId  String
  email           String
  role            Role
  token           String    @unique
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("invitations")
}

model LoginToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("login_tokens")
}

enum FormStatus {
  draft
  published
}

// form-editor (#6): borrador JSON + metadatos. No hay FormVersion ni
// Submission todavía (form-publishing / submissions-dashboard).
model Form {
  id             String     @id @default(cuid())
  organizationId String
  name           String
  status         FormStatus @default(draft)
  draftSchema    Json
  archivedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("forms")
}

// submissions-dashboard (#7): sin clave foránea a Form ni FormVersion
// (formId es un identificador lógico; ver specs/submissions-dashboard/design.md).
model Submission {
  id                  String   @id @default(cuid())
  organizationId      String
  formId              String
  formTitle           String
  clientId            String
  formVersionSnapshot Json
  answers             Json
  submittedByName     String?
  capturedAt          DateTime
  syncedAt            DateTime @default(now())
  createdAt           DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, clientId])
  @@index([organizationId, formId, capturedAt])
  @@map("submissions")
}

enum StoredFileKind {
  photo
  signature
  document
}

// file-storage (#25): metadatos de los archivos guardados en S3. Sin clave
// foránea a Submission (submissionId es un identificador lógico; null =
// huérfano; ver specs/file-storage/design.md).
model StoredFile {
  id             String         @id @default(cuid())
  organizationId String
  key            String         @unique
  uploadId       String
  kind           StoredFileKind
  contentType    String
  sizeBytes      Int
  submissionId   String?
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, uploadId])
  @@index([organizationId, submissionId])
  @@index([submissionId, createdAt])
  @@map("stored_files")
}
