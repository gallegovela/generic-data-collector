// prisma/schema.prisma
// Cada módulo añade sus propios modelos y su propia migración.
// tenancy-auth (#4) añade la primera migración de negocio: Organization,
// User, Invitation, LoginToken (ver specs/tenancy-auth/design.md).

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  admin
  collector
}

enum UserStatus {
  active
  inactive
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  invitations Invitation[]
  forms       Form[]
  submissions Submission[]
  storedFiles StoredFile[]

  @@map("organizations")
}

model User {
  id             String     @id @default(cuid())
  organizationId String
  email          String     @unique
  name           String
  passwordHash   String
  role           Role
  status         UserStatus @default(active)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  loginTokens  LoginToken[]

  @@index([organizationId])
  @@map("users")
}

model Invitation {
  id              String    @id @default(cuid())
  organizationId  String
  email           String
  role            Role
  token           String    @unique
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("invitations")
}

model LoginToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("login_tokens")
}

enum FormStatus {
  draft
  published
}

// form-editor (#6): borrador JSON + metadatos. No hay FormVersion ni
// Submission todavía (form-publishing / submissions-dashboard).
model Form {
  id               String         @id @default(cuid())
  organizationId   String
  name             String
  status           FormStatus     @default(draft)
  draftSchema      Json
  archivedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  // form-publishing (#26)
  slug             String?        @unique
  accessMode       FormAccessMode @default(registered)
  publishedVersion Int? // última versión publicada (se conserva al despublicar)

  organization Organization @relation(fields: [organizationId], references: [id])
  versions     FormVersion[]

  @@index([organizationId])
  @@map("forms")
}

enum FormAccessMode {
  registered
  public
}

// form-publishing (#26): esquema inmutable de cada publicación.
model FormVersion {
  id                String   @id @default(cuid())
  formId            String
  organizationId    String
  version           Int
  schema            Json
  publishedByUserId String?
  createdAt         DateTime @default(now())

  form Form @relation(fields: [formId], references: [id])

  @@unique([formId, version])
  @@index([organizationId, formId])
  @@map("form_versions")
}

// submissions-dashboard (#7): sin clave foránea a Form ni FormVersion
// (formId es un identificador lógico; ver specs/submissions-dashboard/design.md).
model Submission {
  id                  String   @id @default(cuid())
  organizationId      String
  formId              String
  formTitle           String
  clientId            String
  formVersionSnapshot Json
  answers             Json
  submittedByName     String?
  // #27: identificadores lógicos, sin clave foránea (como formId).
  formVersionId       String?
  formVersionNumber   Int?
  submittedByUserId   String?
  capturedAt          DateTime
  syncedAt            DateTime @default(now())
  createdAt           DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, clientId])
  @@index([organizationId, formId, capturedAt])
  @@index([organizationId, formId, formVersionNumber])
  @@map("submissions")
}

enum StoredFileKind {
  photo
  signature
  document
}

// file-storage (#25): metadatos de los archivos guardados en S3. Sin clave
// foránea a Submission (submissionId es un identificador lógico; null =
// huérfano; ver specs/file-storage/design.md).
model StoredFile {
  id             String         @id @default(cuid())
  organizationId String
  key            String         @unique
  uploadId       String
  kind           StoredFileKind
  contentType    String
  sizeBytes      Int
  submissionId   String?
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, uploadId])
  @@index([organizationId, submissionId])
  @@index([submissionId, createdAt])
  @@map("stored_files")
}

// outputs (#35): destinos por formulario y cola de envíos en PostgreSQL.
// formId y submissionId son identificadores lógicos, sin clave foránea.
enum DestinationKind {
  email
  webhook
}

enum DeliveryStatus {
  pending
  sending
  sent
  failed
}

model Destination {
  id             String          @id @default(cuid())
  organizationId String
  formId         String
  kind           DestinationKind
  enabled        Boolean         @default(true)
  emailTo        String[]
  webhookUrl     String?
  webhookSecret  String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([formId, kind])
  @@index([organizationId, formId])
  @@map("destinations")
}

model Delivery {
  id             String          @id @default(cuid())
  organizationId String
  destinationId  String
  formId         String
  submissionId   String
  kind           DestinationKind
  status         DeliveryStatus  @default(pending)
  attempts       Int             @default(0)
  nextAttemptAt  DateTime
  lastError      String?
  lastStatusCode Int?
  sentAt         DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([destinationId, submissionId])
  @@index([status, nextAttemptAt])
  @@index([organizationId, formId, createdAt])
  @@map("deliveries")
}

model DeliveryAttempt {
  id             String   @id @default(cuid())
  deliveryId     String
  organizationId String
  number         Int
  startedAt      DateTime
  durationMs     Int
  ok             Boolean
  statusCode     Int?
  error          String?

  @@index([deliveryId, number])
  @@index([organizationId])
  @@map("delivery_attempts")
}
