# Variables de entorno de platform y tenancy-auth (ver specs/platform/ y
# specs/tenancy-auth/README.md). Cada módulo posterior añade aquí las
# suyas cuando se diseñe (IA, salidas...). Sin secretos reales: solo
# placeholders.

NODE_ENV=development
PORT=3000

# PostgreSQL (docker-compose.yml levanta este servicio en local).
DATABASE_URL=postgresql://formia:formia@localhost:5432/formia

# Credenciales de PostgreSQL. Solo las usa docker-compose.prod.yml, que
# además construye DATABASE_URL con ellas (la contraseña debe ser segura
# para una URL: letras, números, - y _).
POSTGRES_USER=formia
POSTGRES_PASSWORD=changeme
POSTGRES_DB=formia

# Qué servicios levanta Compose en contenedores propios (docker-compose.yml
# y docker-compose.prod.yml): postgres, minio, los dos ("postgres,minio") o
# ninguno ("none", para usar servicios externos del servidor).
COMPOSE_PROFILES=postgres,minio
# Dónde encuentra la app PostgreSQL y el S3 desde dentro de Docker. Por
# defecto, los contenedores propios. Con servicios externos, p. ej.
# POSTGRES_HOST=shared-postgres y S3_DOCKER_ENDPOINT=http://shared-garage:3900.
POSTGRES_HOST=formia-postgres
POSTGRES_PORT=5432
S3_DOCKER_ENDPOINT=http://minio:9000
# Red Docker existente a la que se une la app (la de los servicios externos).
SHARED_NETWORK=gallegovela-shared
# Puerto del host donde se publica la app.
APP_PORT=3000

# Almacenamiento compatible con S3 (MinIO en local, docker-compose.yml).
# En docker-compose.prod.yml, S3_ACCESS_KEY y S3_SECRET_KEY son también el
# usuario y la contraseña root de MinIO (la contraseña, mínimo 8 caracteres).
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-1
S3_ACCESS_KEY=changeme
S3_SECRET_KEY=changeme
S3_BUCKET=formia
S3_FORCE_PATH_STYLE=true
# file-storage (specs/file-storage/): host con el que se firman las URLs que
# abre el navegador. Déjalo comentado si la app y el navegador ven el mismo
# S3_ENDPOINT; no lo apuntes a localhost en el entorno de pruebas.
# S3_PUBLIC_ENDPOINT=https://files.example.com
# Tamaño máximo de subida en bytes (10 MB) y vida de la URL firmada (máx. 900 s).
STORAGE_MAX_UPLOAD_BYTES=10485760
STORAGE_SIGNED_URL_TTL_SECONDS=900

# Autenticación (Auth.js v5, ver specs/tenancy-auth/design.md).
# AUTH_SECRET firma la cookie de sesión (JWT): genera uno propio con
# `openssl rand -base64 32`, nunca un secreto real en el repositorio.
AUTH_SECRET=changeme-generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# SMTP genérico para enlaces mágicos e invitaciones (Mailpit en local,
# docker-compose.yml). SMTP_USER/SMTP_PASSWORD vacíos = sin autenticación.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@formia.local
SMTP_USER=
SMTP_PASSWORD=

# field-collector (specs/field-collector/): relleno público.
# Saltos de proxy de confianza para leer la IP en x-forwarded-for (desde el final).
TRUSTED_PROXY_HOPS=1
# Límites por IP y formulario, por 10 min, solo para anónimos.
FILL_RATE_LIMIT_UPLOAD=200
FILL_RATE_LIMIT_SUBMIT=60
