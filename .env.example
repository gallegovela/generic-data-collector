# Variables de entorno del módulo platform (ver specs/platform/README.md).
# Cada módulo posterior añade aquí las suyas cuando se diseñe
# (autenticación, email, IA...). Sin secretos reales: solo placeholders.

NODE_ENV=development
PORT=3000

# PostgreSQL (docker-compose.yml levanta este servicio en local).
DATABASE_URL=postgresql://formia:formia@localhost:5432/formia

# Almacenamiento compatible con S3 (MinIO en local, docker-compose.yml).
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-1
S3_ACCESS_KEY=changeme
S3_SECRET_KEY=changeme
S3_BUCKET=formia
S3_FORCE_PATH_STYLE=true
